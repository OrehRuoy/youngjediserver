; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Young Jedi Client"
config/version="1.0.8"
run/main_scene="res://scenes/login.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.png"

[autoload]

Connection="*res://scripts/connection.gd"
CardCatalog="*res://scripts/card_catalog.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=900
window/size/min_height=600

[gui]

theme="res://theme/game_theme.tres"
