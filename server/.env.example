# Optional: copy to .env and edit. Loaded automatically on server start.
#
# Local (Windows): leave HOST/PORT unset → 127.0.0.1:49152
# Render/Fly: they set PORT; HOST defaults to 0.0.0.0 when PORT is set.
# HOST=0.0.0.0
# PORT=10000
#
# Trust X-Forwarded-For (on by default when PORT is set). Required on Render.
# TRUST_PROXY=1
#
# Household play: more than one client behind the same public IP.
# MAX_CONNECTIONS_PER_IP=4
# MAX_CONNECTIONS=32
#
# Extra IPs allowed unlimited connections (comma-separated). Localhost is always allowed.
# ALLOW_MULTI_IP=
