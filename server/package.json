{
  "name": "young-jedi-server",
  "version": "1.0.0",
  "description": "Server-authoritative Young Jedi TCG - WebSocket lobby, tables, game engine",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "serve": "node ../scripts/sync-cards.js && npm run build && node dist/index.js",
    "dev": "ts-node src/index.ts",
    "sync-cards": "node ../scripts/sync-cards.js",
    "headless": "node dist/headless-runner.js",
    "headless:dev": "npx ts-node src/headless-runner.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0"
  }
}
